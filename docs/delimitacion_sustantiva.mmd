    ROOT --> CONTENIDO["<b>CONTENIDO</b>"]
    ROOT --> COMERCIAL["<b>COMERCIAL</b>"]
    ROOT --> REPORTE["<b>REPORTE</b>"]

    %% ADMINISTRACIÓN
    ADMIN --> A1["GESTIONAR USUARIO"]
    ADMIN --> A2["GESTIONAR ROL"]
    ADMIN --> A3["GESTIONAR PERMISO"]
    ADMIN --> A4["GESTIONAR EMPRESA"]
    ADMIN --> A5["GESTIONAR SUCURSAL"]

    %% CATÁLOGO
    CATALOGO --> C1["GESTIONAR PRODUCTO"]
    CATALOGO --> C2["GESTIONAR CATEGORÍA"]
    CATALOGO --> C3["GESTIONAR MARCA"]
    CATALOGO --> C4["GESTIONAR ATRIBUTO"]
    CATALOGO --> C5["GESTIONAR TIPO ATRIBUTO"]

    %% CONTENIDO
    CONTENIDO --> CT1["GESTIONAR MENÚ"]
    CONTENIDO --> CT2["GESTIONAR FOOTER"]
    CONTENIDO --> CT3["GESTIONAR HERO"]
    CONTENIDO --> CT4["GESTIONAR PASOS WIZARD"]
    CONTENIDO --> CT5["GESTIONAR SECCIÓN"]
    CONTENIDO --> CT6["GESTIONAR REGISTRO"]
    CONTENIDO --> CT7["GESTIONAR CONFIGURACIÓN"]

    %% COMERCIAL
    COMERCIAL --> CM1["GESTIONAR CONTACTO"]
    COMERCIAL --> CM2["GESTIONAR SUSCRIPTOR"]

    %% REPORTE
    REPORTE --> R1["GENERAR REPORTE DE AUDITORÍA"]

    %% Estilos de colores por módulo
    classDef adminStyle fill:#6baed6,stroke:#08306b,color:#fff
    classDef catalogoStyle fill:#4292c6,stroke:#08306b,color:#fff
    classDef contenidoStyle fill:#2171b5,stroke:#08306b,color:#fff
    classDef comercialStyle fill:#08519c,stroke:#08306b,color:#fff
    classDef reporteStyle fill:#08306b,stroke:#08306b,color:#fff
    classDef rootStyle fill:#e6e6e6,stroke:#999,color:#333

    class ROOT rootStyle
    class ADMIN,A1,A2,A3,A4,A5 adminStyle
    class CATALOGO,C1,C2,C3,C4,C5 catalogoStyle
    class CONTENIDO,CT1,CT2,CT3,CT4,CT5,CT6,CT7 contenidoStyle
    class COMERCIAL,CM1,CM2 comercialStyle
    class REPORTE,R1 reporteStyle